# Staging: copia a .env.staging, completa TODOS los valores y no lo subas al repositorio.
DOMAIN=api-staging.tudominio.com            # el DNS debe apuntar a este servidor (Caddy emite el certificado)

POSTGRES_USER=centroactoral
POSTGRES_PASSWORD=                          # openssl rand -hex 24 (sin caracteres especiales)
POSTGRES_DB=dbcentroactoral

JWT_SECRET=                                 # openssl rand -hex 48
CERT_HMAC_SECRET=                           # openssl rand -hex 48  (DISTINTO de JWT_SECRET)
FRONTEND_URL=https://staging.tudominio.com
CORS_ORIGIN=https://staging.tudominio.com
SWAGGER_ENABLED=false
VERIFY_BASE_URL=https://staging.tudominio.com/verificar

# Correo real (p. ej. Amazon SES SMTP, SendGrid, etc.)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Centro Actoral de Boyacá <no-reply@tudominio.com>"

# Archivos: AWS S3 real. Si el servidor es una EC2 con rol IAM, deja las claves vacías.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false                 # crea el bucket privado a mano (acceso público bloqueado)
S3_BUCKET=centro-actoral-staging-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_TTL=900

# Certificados
CERT_VIGENCIA_DIAS=90
INSTITUCION_NOMBRE=Centro Actoral de Boyacá
INSTITUCION_FIRMANTE=
INSTITUCION_CARGO=Director(a)
INSTITUCION_COLOR=#1F3A5F
CERT_P12_BASE64=
CERT_P12_PASSWORD=

# Respaldos (bucket DISTINTO al de los archivos)
BACKUP_S3_BUCKET=centro-actoral-staging-backups
BACKUP_S3_PREFIX=postgres
BACKUP_AWS_ACCESS_KEY_ID=                   # usuario IAM solo con permisos sobre el bucket de respaldos
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_HEARTBEAT_URL=                       # opcional: URL de healthchecks.io; si no llega el aviso, te alerta
BACKUP_ON_START=false
