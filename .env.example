# Copia a .env y cambia los valores. NUNCA subas .env al repositorio.
# La API NO arranca si JWT_SECRET sigue siendo el valor de ejemplo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave      # evita caracteres especiales (@ : / ?) por la DATABASE_URL
POSTGRES_DB=dbcentroactoral
POSTGRES_PORT=5433                       # puerto en tu PC (5433 para no chocar con un Postgres local)

PGADMIN_EMAIL=admin@centroactoral.com
PGADMIN_PASSWORD=cambia_esta_clave

JWT_SECRET=genera_uno_con__openssl_rand_-hex_48   # >= 32 caracteres: openssl rand -hex 48
# El sitio web (public/) lo sirve la propia API, así que todo vive en el puerto 3000.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000        # varios orígenes separados por coma (añade tu IP para probar desde el celular)

SWAGGER_ENABLED=true                     # false en producción
TRUST_PROXY=                             # true si hay un reverse proxy delante de la API

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Centro Actoral de Boyacá <no-reply@centroactoral.com>"

# --- Certificados digitales (Semana 4) ---
CERT_HMAC_SECRET=genera_uno_distinto_al_JWT   # >= 32 caracteres, DISTINTO de JWT_SECRET: openssl rand -hex 48
CERT_VIGENCIA_DIAS=90
VERIFY_BASE_URL=                              # URL pública de verificación (el QR agrega /CODIGO). Vacío = FRONTEND_URL/verificar
INSTITUCION_NOMBRE=Centro Actoral de Boyacá
INSTITUCION_FIRMANTE=Dirección del Centro Actoral
INSTITUCION_CARGO=Director(a)
INSTITUCION_COLOR=#1F3A5F
# Firma digital PAdES (opcional): .p12 de una entidad de certificación acreditada, en base64
#   base64 -w0 certificado.p12
CERT_P12_BASE64=
CERT_P12_PASSWORD=

# --- Almacenamiento de multimedia (S3 / MinIO) ---
# En local se usa MinIO (incluido en docker-compose). Para AWS S3 real: deja S3_ENDPOINT y
# S3_PUBLIC_ENDPOINT vacíos, pon S3_FORCE_PATH_STYLE=false y usa tus credenciales IAM.
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=cambia_esta_clave_minio       # mínimo 8 caracteres
S3_BUCKET=centro-actoral
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true                  # false en producción (crea el bucket privado a mano)
SIGNED_URL_TTL=900                          # segundos de vigencia de las URLs firmadas

# Primer administrador (se crea con: docker compose exec api node dist/seed.js)
# Mínimo 12 caracteres, letras y números. El seed rechaza el valor de ejemplo.
ADMIN_SEED_EMAIL=admin@centroactoral.com
ADMIN_SEED_PASSWORD=cambia_esta_clave_larga_123

# --- Sitio web ---
# STORAGE=s3 (por defecto): fotos y documentos van a MinIO/S3. Para ver desde el celular, cambia
# S3_PUBLIC_ENDPOINT a http://TU_IP_LOCAL:9000 (las imágenes se piden a ese host).
# Con la API fuera de Docker puedes usar STORAGE=local (carpeta ./uploads).
STORAGE=s3
# Si usas RUN_MIGRATIONS=true la API aplica 000..007 al arrancar (necesario para adoptar una base anterior).
RUN_MIGRATIONS=false
