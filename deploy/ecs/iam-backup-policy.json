{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EscribirRespaldos",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::centro-actoral-prod-backups/*"
    },
    {
      "Sid": "ListarRespaldos",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::centro-actoral-prod-backups"
    }
  ]
}
