    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
