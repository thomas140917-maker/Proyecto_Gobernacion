    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "5.22.0",
    "@signpdf/placeholder-plain": "^3.0.0",
    "@signpdf/signer-p12": "^3.0.0",
